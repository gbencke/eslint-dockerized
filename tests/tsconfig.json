{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "ES2023", "DOM"]
  },
  "include": [
    "*.d.ts",
    "fixtures/**/*.ts",
    "fixtures/**/*.tsx"
  ]
}
